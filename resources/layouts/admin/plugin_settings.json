{
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "permissions": [
        "core.plugins.read"
    ],
    "extends": "_admin_base",
    "scripts": [
        {
            "src": "/api/plugins/g7-home-widgets/board-filter-drag.js?v=0.3.0",
            "id": "g7_home_widgets_board_filter_drag",
            "async": true
        }
    ],
    "meta": {
        "title": "$t:g7-home-widgets.settings.title",
        "description": "$t:g7-home-widgets.settings.description"
    },
    "data_sources": [
        {
            "id": "boardFilter",
            "label_key": "$t:g7-home-widgets.editor.data_source.board_filter",
            "type": "api",
            "endpoint": "/api/plugins/g7-home-widgets/admin/board-filter",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "refetchOnMount": true,
            "onSuccess": [
                {
                    "handler": "setState",
                    "params": {
                        "target": "local",
                        "excluded": "{{response.data.data.excluded_board_ids ?? []}}",
                        "included": "{{(response.data.data.boards ?? []).map(b => b.id).filter(id => !(response.data.data.excluded_board_ids ?? []).includes(id))}}",
                        "dirty": false
                    }
                }
            ]
        }
    ],
    "slots": {
        "content": [
            {
                "id": "home_widgets_settings_content",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:g7-home-widgets.settings.title",
                            "description": "$t:g7-home-widgets.settings.description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "notice_banner",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "alert-info"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "circle-info",
                                            "className": "text-xl text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-info-soft font-medium"
                                                },
                                                "text": "$t:g7-home-widgets.settings.notice",
                                                "id": "board_filter_notice"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-info-soft mt-1"
                                                },
                                                "text": "$t:g7-home-widgets.settings.help"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "validation_error",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors}}",
                        "props": {
                            "className": "alert-danger"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Ul",
                                "props": {
                                    "className": "list-disc list-inside space-y-1"
                                },
                                "iteration": {
                                    "source": "Object.values(_local.errors ?? {}).flatMap(m => Array.isArray(m) ? m : [m])",
                                    "item_var": "message"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-error-soft"
                                        },
                                        "text": "{{message}}"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "board_filter_panel",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-4"
                                },
                                "children": [
                                    {
                                        "id": "board_filter_query",
                                        "type": "basic",
                                        "name": "Input",
                                        "props": {
                                            "type": "search",
                                            "name": "board_filter_query",
                                            "value": "{{_local.q ?? ''}}",
                                            "placeholder": "$t:g7-home-widgets.settings.filter_placeholder",
                                            "className": "input w-full sm:max-w-xs"
                                        },
                                        "actions": [
                                            {
                                                "type": "change",
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "q": "{{$event.target.value}}"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "text-sm text-gray-400"
                                        },
                                        "text": "$t:g7-home-widgets.settings.loading",
                                        "if": "{{!boardFilter?.data}}"
                                    },
                                    {
                                        "id": "zone_included",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "data-zone-drop": "included",
                                            "className": "rounded-lg border-2 border-dashed p-4 min-h-24 border-blue-200 dark:border-blue-900/60"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex items-baseline gap-2 mb-3"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "H3",
                                                        "props": {
                                                            "className": "text-sm font-semibold text-gray-900 dark:text-white"
                                                        },
                                                        "text": "$t:g7-home-widgets.settings.included_title"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "badge badge-gray"
                                                        },
                                                        "text": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.included ?? []).includes(b.id)).length}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:g7-home-widgets.settings.included_hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex flex-wrap gap-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "iteration": {
                                                            "source": "(boardFilter?.data?.boards ?? []).filter(b => (_local.included ?? []).includes(b.id) && (!_local.q || String(b.name ?? '').toLowerCase().includes(String(_local.q).trim().toLowerCase())))",
                                                            "item_var": "board"
                                                        },
                                                        "props": {
                                                            "draggable": true,
                                                            "data-board-card": "{{board.id}}",
                                                            "data-zone": "included",
                                                            "className": "group flex items-center gap-2 pl-3 pr-1 py-1.5 rounded-lg border cursor-grab select-none bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Icon",
                                                                "props": {
                                                                    "name": "grip-vertical",
                                                                    "className": "w-3 h-3 text-gray-400"
                                                                }
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "text-sm font-medium"
                                                                },
                                                                "text": "{{board.name}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "text-xs text-gray-400 dark:text-gray-500"
                                                                },
                                                                "text": "{{board.slug}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "badge badge-gray"
                                                                },
                                                                "text": "$t:g7-home-widgets.settings.inactive",
                                                                "if": "{{!board.is_active}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Button",
                                                                "props": {
                                                                    "type": "button",
                                                                    "data-board-action": "exclude",
                                                                    "title": "$t:g7-home-widgets.settings.exclude",
                                                                    "aria-label": "$t:g7-home-widgets.settings.exclude",
                                                                    "className": "btn-icon ml-1 p-1 rounded text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700"
                                                                },
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "included": "{{(_local.included ?? []).filter(id => id !== board.id)}}",
                                                                            "excluded": "{{(_local.excluded ?? []).includes(board.id) ? (_local.excluded ?? []) : [...(_local.excluded ?? []), board.id]}}",
                                                                            "dirty": true
                                                                        }
                                                                    }
                                                                ],
                                                                "children": [
                                                                    {
                                                                        "type": "basic",
                                                                        "name": "Icon",
                                                                        "props": {
                                                                            "name": "xmark",
                                                                            "className": "w-3 h-3"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-sm text-gray-400 dark:text-gray-500 py-2"
                                                },
                                                "text": "$t:g7-home-widgets.settings.empty_included",
                                                "if": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.included ?? []).includes(b.id)).length === 0}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-sm text-gray-400 dark:text-gray-500 py-2"
                                                },
                                                "text": "$t:g7-home-widgets.settings.no_match",
                                                "if": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.included ?? []).includes(b.id)).length > 0 && (boardFilter?.data?.boards ?? []).filter(b => (_local.included ?? []).includes(b.id) && (!_local.q || String(b.name ?? '').toLowerCase().includes(String(_local.q).trim().toLowerCase()))).length === 0}}"
                                            }
                                        ],
                                        "if": "{{!!boardFilter?.data}}"
                                    },
                                    {
                                        "id": "zone_excluded",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "data-zone-drop": "excluded",
                                            "className": "rounded-lg border-2 border-dashed p-4 min-h-24 border-gray-300 dark:border-gray-600 bg-gray-50/50 dark:bg-gray-900/30"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex items-baseline gap-2 mb-3"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "H3",
                                                        "props": {
                                                            "className": "text-sm font-semibold text-gray-900 dark:text-white"
                                                        },
                                                        "text": "$t:g7-home-widgets.settings.excluded_title"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "badge badge-gray"
                                                        },
                                                        "text": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.excluded ?? []).includes(b.id)).length}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:g7-home-widgets.settings.excluded_hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex flex-wrap gap-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Div",
                                                        "iteration": {
                                                            "source": "(boardFilter?.data?.boards ?? []).filter(b => (_local.excluded ?? []).includes(b.id) && (!_local.q || String(b.name ?? '').toLowerCase().includes(String(_local.q).trim().toLowerCase())))",
                                                            "item_var": "board"
                                                        },
                                                        "props": {
                                                            "draggable": true,
                                                            "data-board-card": "{{board.id}}",
                                                            "data-zone": "excluded",
                                                            "className": "group flex items-center gap-2 pl-3 pr-1 py-1.5 rounded-lg border cursor-grab select-none bg-gray-50 dark:bg-gray-900/50 border-dashed border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Icon",
                                                                "props": {
                                                                    "name": "grip-vertical",
                                                                    "className": "w-3 h-3 text-gray-400"
                                                                }
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "text-sm font-medium line-through"
                                                                },
                                                                "text": "{{board.name}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "text-xs text-gray-400 dark:text-gray-500"
                                                                },
                                                                "text": "{{board.slug}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "props": {
                                                                    "className": "badge badge-gray"
                                                                },
                                                                "text": "$t:g7-home-widgets.settings.inactive",
                                                                "if": "{{!board.is_active}}"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Button",
                                                                "props": {
                                                                    "type": "button",
                                                                    "data-board-action": "include",
                                                                    "title": "$t:g7-home-widgets.settings.include",
                                                                    "aria-label": "$t:g7-home-widgets.settings.include",
                                                                    "className": "btn-icon ml-1 p-1 rounded text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700"
                                                                },
                                                                "actions": [
                                                                    {
                                                                        "type": "click",
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "excluded": "{{(_local.excluded ?? []).filter(id => id !== board.id)}}",
                                                                            "included": "{{(_local.included ?? []).includes(board.id) ? (_local.included ?? []) : [...(_local.included ?? []), board.id]}}",
                                                                            "dirty": true
                                                                        }
                                                                    }
                                                                ],
                                                                "children": [
                                                                    {
                                                                        "type": "basic",
                                                                        "name": "Icon",
                                                                        "props": {
                                                                            "name": "plus",
                                                                            "className": "w-3 h-3"
                                                                        }
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-sm text-gray-400 dark:text-gray-500 py-2"
                                                },
                                                "text": "$t:g7-home-widgets.settings.empty_excluded",
                                                "if": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.excluded ?? []).includes(b.id)).length === 0}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-sm text-gray-400 dark:text-gray-500 py-2"
                                                },
                                                "text": "$t:g7-home-widgets.settings.no_match",
                                                "if": "{{(boardFilter?.data?.boards ?? []).filter(b => (_local.excluded ?? []).includes(b.id)).length > 0 && (boardFilter?.data?.boards ?? []).filter(b => (_local.excluded ?? []).includes(b.id) && (!_local.q || String(b.name ?? '').toLowerCase().includes(String(_local.q).trim().toLowerCase()))).length === 0}}"
                                            }
                                        ],
                                        "if": "{{!!boardFilter?.data}}"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end gap-3"
                                },
                                "children": [
                                    {
                                        "id": "cancel_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "className": "btn btn-secondary"
                                        },
                                        "actions": [
                                            {
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "/admin/plugins"
                                                }
                                            }
                                        ],
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:common.cancel"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "save_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "disabled": "{{!_local.dirty || _local.isSaving || !boardFilter?.data}}",
                                            "className": "btn btn-primary flex-center gap-1.5"
                                        },
                                        "actions": [
                                            {
                                                "type": "click",
                                                "handler": "sequence",
                                                "actions": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": true,
                                                            "errors": null
                                                        }
                                                    },
                                                    {
                                                        "handler": "apiCall",
                                                        "auth_required": true,
                                                        "target": "/api/plugins/g7-home-widgets/admin/board-filter",
                                                        "params": {
                                                            "method": "PUT",
                                                            "body": {
                                                                "excluded_board_ids": "{{_local.excluded ?? []}}"
                                                            }
                                                        },
                                                        "onSuccess": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSaving": false,
                                                                    "dirty": false
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "success",
                                                                    "message": "$t:g7-home-widgets.settings.save_success"
                                                                }
                                                            },
                                                            {
                                                                "handler": "refetchDataSource",
                                                                "params": {
                                                                    "dataSourceId": "boardFilter"
                                                                }
                                                            }
                                                        ],
                                                        "onError": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSaving": false,
                                                                    "errors": "{{error.errors}}"
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "error",
                                                                    "message": "{{error.message ?? '$t:g7-home-widgets.settings.save_error'}}"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ],
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Icon",
                                                "if": "{{_local.isSaving}}",
                                                "props": {
                                                    "name": "spinner",
                                                    "className": "spinner-sm"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "{{_local.isSaving ? '$t:common.saving' : '$t:common.save'}}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "schema": {
        "excluded_board_ids": {
            "type": "array",
            "default": [],
            "label": "$t:g7-home-widgets.settings.excluded_title",
            "hint": "$t:g7-home-widgets.settings.notice"
        }
    }
}
