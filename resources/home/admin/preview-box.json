{
    "_comment": "[위젯 레이아웃] 탭 왼쪽 미리보기의 섹션 박스(__S__ = 1..5). 현재 폼 값을 그대로 따른다: 꺼짐 = 흐림, 2단 = 좌우 분할. 오른쪽 섹션 줄에 마우스를 올리거나(hwHover) 그 줄에 포커스가 가면(hwFocus) 강조한다.",
    "type": "basic",
    "name": "Div",
    "props": {
        "data-testid": "g7hw-admin-box-s__S__",
        "data-active": "{{(_local.hwHover ?? _local.hwFocus) === __S__ ? '1' : '0'}}",
        "data-enabled": "{{_local.form?.s__S___enabled ? '1' : '0'}}",
        "data-columns": "{{String(_local.form?.s__S___columns ?? '1')}}",
        "style": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "0.375rem",
            "padding": "0.5rem",
            "borderRadius": "0.5rem",
            "borderWidth": "2px",
            "borderStyle": "dashed",
            "borderColor": "{{(_local.hwHover ?? _local.hwFocus) === __S__ ? '#2563eb' : '#cbd5e1'}}",
            "backgroundColor": "{{(_local.hwHover ?? _local.hwFocus) === __S__ ? 'rgba(37, 99, 235, 0.08)' : 'transparent'}}",
            "opacity": "{{_local.form?.s__S___enabled ? '1' : '0.4'}}",
            "transition": "border-color 0.15s, background-color 0.15s"
        }
    },
    "children": [
        {
            "type": "basic",
            "name": "Span",
            "props": {
                "className": "text-xs font-semibold text-gray-600 dark:text-gray-300"
            },
            "text": "{{_local.form?.s__S___enabled ? '$t:g7-home-widgets.home.preview.s__S__' : '$t:g7-home-widgets.home.preview.s__S___off'}}"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "style": {
                    "display": "flex",
                    "gap": "0.375rem",
                    "minHeight": "2rem"
                }
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "data-testid": "g7hw-admin-box-s__S__-c1",
                        "style": {
                            "flex": "1 1 0%",
                            "borderRadius": "0.25rem",
                            "border": "1px dashed #94a3b8"
                        }
                    }
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{String(_local.form?.s__S___columns ?? '1') === '2'}}",
                    "props": {
                        "data-testid": "g7hw-admin-box-s__S__-c2",
                        "style": {
                            "flex": "1 1 0%",
                            "borderRadius": "0.25rem",
                            "border": "1px dashed #94a3b8"
                        }
                    }
                }
            ]
        }
    ]
}
