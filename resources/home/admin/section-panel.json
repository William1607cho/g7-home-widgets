{
    "type": "basic",
    "name": "Div",
    "if": "{{(_local.ui?.tab ?? 'layout') === 's__S__'}}",
    "props": {
        "className": "mt-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 space-y-4",
        "style": {
            "width": "100%"
        },
        "data-testid": "g7hw-admin-panel-s__S__"
    },
    "children": [
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "text-sm text-gray-500 dark:text-gray-400"
            },
            "text": "$t:g7-home-widgets.home.section_desc.s__S__"
        },
        {
            "type": "basic",
            "name": "P",
            "if": "{{!_local.form?.s__S___enabled}}",
            "props": {
                "className": "alert-info text-sm",
                "data-testid": "g7hw-admin-off-s__S__"
            },
            "text": "$t:g7-home-widgets.home.col.section_off"
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{!!_local.form?.s__S___enabled && String(_local.form?.s__S___columns ?? '1') === '2'}}",
            "props": {
                "className": "flex flex-wrap gap-2 border-b border-gray-200 dark:border-gray-700",
                "data-testid": "g7hw-admin-subtabs-s__S__"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                        "type": "button",
                        "data-testid": "g7hw-admin-subtab-s__S__c1",
                        "data-active": "{{(_local.hwCol?.s__S__ ?? '1') === '1' ? '1' : '0'}}",
                        "className": "{{(_local.hwCol?.s__S__ ?? '1') === '1' ? 'px-4 py-2 -mb-px text-sm font-medium border-b-2 border-blue-600 text-blue-600 dark:text-blue-400' : 'px-4 py-2 -mb-px text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400'}}"
                    },
                    "actions": [
                        {
                            "type": "click",
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "hwCol.s__S__": "1"
                            }
                        }
                    ],
                    "children": "__SUBTAB_LABEL_C1__"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                        "type": "button",
                        "data-testid": "g7hw-admin-subtab-s__S__c2",
                        "data-active": "{{(_local.hwCol?.s__S__ ?? '1') === '2' ? '1' : '0'}}",
                        "className": "{{(_local.hwCol?.s__S__ ?? '1') === '2' ? 'px-4 py-2 -mb-px text-sm font-medium border-b-2 border-blue-600 text-blue-600 dark:text-blue-400' : 'px-4 py-2 -mb-px text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400'}}"
                    },
                    "actions": [
                        {
                            "type": "click",
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "hwCol.s__S__": "2"
                            }
                        }
                    ],
                    "children": "__SUBTAB_LABEL_C2__"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{!!_local.form?.s__S___enabled}}",
            "props": {
                "style": {
                    "width": "100%"
                }
            },
            "children": "__COLS__"
        }
    ]
}
