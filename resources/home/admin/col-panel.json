{
    "type": "basic",
    "name": "Div",
    "if": "{{'__C__' === '1' || String(_local.form?.s__S___columns ?? '1') === '2'}}",
    "props": {
        "className": "space-y-4 p-4 rounded-lg border border-gray-100 dark:border-gray-700",
        "data-testid": "g7hw-admin-__K__"
    },
    "children": [
        {
            "type": "basic",
            "name": "H3",
            "props": {
                "className": "text-sm font-semibold text-gray-900 dark:text-white"
            },
            "text": "$t:g7-home-widgets.home.col.col__C__"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex flex-wrap items-end gap-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___type",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.type"
                        },
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "id": "__K___type",
                                "name": "__K___type",
                                "className": "input",
                                "options": "__TYPE_OPTIONS__"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.form?.__K___type !== 'html'}}",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___limit",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.limit"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "id": "__K___limit",
                                "name": "__K___limit",
                                "type": "number",
                                "min": 1,
                                "max": "{{_local.form?.__K___type === 'ticker' ? 10 : 20}}",
                                "className": "input w-24"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.form?.__K___type === 'popular'}}",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___period",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.period"
                        },
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "id": "__K___period",
                                "name": "__K___period",
                                "className": "input",
                                "options": [
                                    { "value": "week", "label": "$t:g7-home-widgets.home.periods.week" },
                                    { "value": "month", "label": "$t:g7-home-widgets.home.periods.month" },
                                    { "value": "year", "label": "$t:g7-home-widgets.home.periods.year" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.form?.__K___type === 'ticker'}}",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___board",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.ticker_board"
                        },
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "id": "__K___board",
                                "name": "__K___board",
                                "className": "input",
                                "placeholder": "$t:g7-home-widgets.home.col.ticker_pick",
                                "options": "{{(boardFilter?.data?.boards ?? []).filter(b => b.is_active).map(b => ({ value: b.id, label: b.name }))}}"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex flex-wrap items-end gap-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___title",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.title"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "id": "__K___title",
                                "name": "__K___title",
                                "type": "text",
                                "maxLength": 60,
                                "placeholder": "$t:g7-home-widgets.home.col.title_placeholder",
                                "className": "input w-64"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___icon",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.icon"
                        },
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "id": "__K___icon",
                                "name": "__K___icon",
                                "className": "input",
                                "options": "__ICON_OPTIONS__"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Icon",
                    "if": "{{_local.form?.__K___icon}}",
                    "props": {
                        "name": "{{_local.form?.__K___icon}}",
                        "className": "w-5 h-5 text-gray-500"
                    }
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.form?.__K___type === 'html'}}",
            "props": {
                "className": "space-y-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "htmlFor": "__K___html",
                        "className": "form-label"
                    },
                    "text": "$t:g7-home-widgets.home.col.html"
                },
                {
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                        "id": "__K___html",
                        "name": "__K___html",
                        "rows": 8,
                        "maxLength": 20000,
                        "className": "input w-full font-mono text-sm"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-xs text-gray-500 dark:text-gray-400"
                    },
                    "text": "$t:g7-home-widgets.home.col.html_help"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.form?.__K___type !== 'ticker' && _local.form?.__K___type !== 'html'}}",
            "props": {
                "className": "space-y-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-center gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "htmlFor": "__K___mode",
                                "className": "form-label"
                            },
                            "text": "$t:g7-home-widgets.home.col.boards"
                        },
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "id": "__K___mode",
                                "name": "__K___mode",
                                "className": "input",
                                "options": [
                                    { "value": "all", "label": "$t:g7-home-widgets.home.col.mode_all" },
                                    { "value": "only", "label": "$t:g7-home-widgets.home.col.mode_only" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.form?.__K___mode === 'only'}}",
                    "props": {
                        "className": "space-y-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-xs text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:g7-home-widgets.home.col.board_pick_help"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex flex-wrap gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "iteration": {
                                        "source": "(boardFilter?.data?.boards ?? []).filter(b => b.is_active && !(_local.excluded ?? []).includes(b.id))",
                                        "item_var": "board"
                                    },
                                    "props": {
                                        "type": "button",
                                        "className": "{{(_local.form?.__K___ids ?? []).map(Number).includes(board.id) ? 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm bg-blue-50 dark:bg-blue-900/30 border-blue-300 dark:border-blue-700 text-blue-700 dark:text-blue-300' : 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300'}}"
                                    },
                                    "actions": [
                                        {
                                            "type": "click",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.__K___ids": "{{(_local.form?.__K___ids ?? []).map(Number).includes(board.id) ? (_local.form?.__K___ids ?? []).map(Number).filter(i => i !== board.id) : [...(_local.form?.__K___ids ?? []).map(Number), board.id]}}",
                                                "dirty": true
                                            }
                                        }
                                    ],
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "{{(_local.form?.__K___ids ?? []).map(Number).includes(board.id) ? 'check' : 'plus'}}",
                                                "className": "w-3 h-3"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "{{board.name}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
