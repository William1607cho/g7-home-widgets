                        "data-hw-zone": "__K__:excluded",
                        "data-testid": "g7hw-admin-__K__-excluded",
                        "className": "rounded-lg border-2 border-dashed p-3 border-gray-300 dark:border-gray-600 bg-gray-50/50 dark:bg-gray-900/30"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-sm font-semibold text-gray-900 dark:text-white mb-2"
                            },
                            "text": "$t:g7-home-widgets.home.col.excluded"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex flex-wrap gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "iteration": {
                                        "source": "(homeMeta?.data?.boards ?? []).filter(b => (_local.form?.__K___ids ?? []).map(Number).includes(b.id) && (!String(_local.hwq?.__K__ ?? '').trim() || String(b.name ?? '').toLowerCase().includes(String(_local.hwq?.__K__).trim().toLowerCase()) || String(b.slug ?? '').toLowerCase().includes(String(_local.hwq?.__K__).trim().toLowerCase())))",
                                        "item_var": "board"
                                    },
                                    "props": {
                                        "draggable": true,
                                        "data-hw-card": "{{board.id}}",
                                        "className": "group flex items-center gap-2 pl-3 pr-1 py-1.5 rounded-lg border border-dashed cursor-grab select-none bg-gray-50 dark:bg-gray-900/50 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "grip-vertical",
                                                "className": "w-3 h-3 text-gray-400"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm font-medium line-through"
                                            },
                                            "text": "{{board.name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-xs text-gray-400 dark:text-gray-500"
                                            },
                                            "text": "{{board.slug}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Button",
                                            "props": {
                                                "type": "button",
                                                "data-hw-move": "include",
                                                "title": "$t:g7-home-widgets.settings.include",
                                                "aria-label": "$t:g7-home-widgets.settings.include",
                                                "className": "btn-icon ml-1 p-1 rounded text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700"
                                            },
                                            "actions": [
                                                {
                                                    "type": "click",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "form.__K___ids": "{{(_local.form?.__K___ids ?? []).map(Number).filter(i => i !== board.id)}}",
                                                        "dirty": true
                                                    }
                                                }
                                            ],
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "plus",
                                                        "className": "w-3 h-3"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
