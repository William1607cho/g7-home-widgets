{
    "type": "basic",
    "name": "Div",
    "if": "{{col.type === 'popular'}}",
    "props": {
        "className": "g7hw-w g7hw-w-popular"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "g7hw-head"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "g7hw-title"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "{{col.icon}}",
                                "className": "g7hw-title-icon"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{col.title}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "g7hw-tabs"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "iteration": {
                                "source": "{{col.periods ?? []}}",
                                "item_var": "p"
                            },
                            "props": {
                                "type": "button",
                                "className": "{{((_local.g7hwTab?.[col.key] ?? col.period) === p.key) ? 'g7hw-tab is-active' : 'g7hw-tab'}}"
                            },
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "g7hwTab": "{{({[col.key]: p.key})}}"
                                    }
                                }
                            ],
                            "text": "{{p.label}}"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Ul",
            "iteration": {
                "source": "{{col.periods ?? []}}",
                "item_var": "p"
            },
            "if": "{{(_local.g7hwTab?.[col.key] ?? col.period) === p.key && p.items && p.items.length > 0}}",
            "props": {
                "className": "g7hw-list g7hw-period",
                "data-period": "{{p.key}}"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Li",
                    "iteration": {
                        "source": "{{p.items ?? []}}",
                        "item_var": "item"
                    },
                    "props": {
                        "className": "g7hw-item"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "A",
                            "props": {
                                "className": "g7hw-link",
                                "href": "/board/{{item.board_slug}}/{{item.id}}"
                            },
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/board/{{item.board_slug}}/{{item.id}}"
                                    }
                                }
                            ],
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "g7hw-line1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-item-title"
                                            },
                                            "text": "{{item.title}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "g7hw-line2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-board"
                                            },
                                            "text": "{{item.board_name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-views"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "eye",
                                                        "className": "g7hw-eye"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{item.view_count ?? 0}}"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-date",
                                                "title": "{{item.created_at ?? ''}}"
                                            },
                                            "text": "{{item.created_at_formatted ?? ''}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "P",
            "iteration": {
                "source": "{{col.periods ?? []}}",
                "item_var": "p"
            },
            "if": "{{(_local.g7hwTab?.[col.key] ?? col.period) === p.key && (!p.items || p.items.length === 0)}}",
            "props": {
                "className": "g7hw-empty g7hw-period",
                "data-period": "{{p.key}}"
            },
            "text": "{{col.empty_text}}"
        }
    ]
}
