{
    "type": "basic",
    "name": "Div",
    "if": "{{col.type === 'recent'}}",
    "props": {
        "className": "g7hw-w g7hw-w-recent"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "g7hw-head"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "g7hw-title"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "{{col.icon}}",
                                "className": "g7hw-title-icon"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{col.title}}"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Ul",
            "if": "{{col.items && col.items.length > 0}}",
            "props": {
                "className": "g7hw-list"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Li",
                    "iteration": {
                        "source": "{{col.items ?? []}}",
                        "item_var": "item"
                    },
                    "props": {
                        "className": "g7hw-item"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "A",
                            "props": {
                                "className": "g7hw-link",
                                "href": "/board/{{item.board_slug}}/{{item.id}}"
                            },
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/board/{{item.board_slug}}/{{item.id}}"
                                    }
                                }
                            ],
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "g7hw-line1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{item.is_secret}}",
                                            "props": {
                                                "name": "lock",
                                                "className": "g7hw-lock"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-item-title"
                                            },
                                            "text": "{{item.title}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{item.is_new}}",
                                            "props": {
                                                "className": "g7hw-new"
                                            },
                                            "text": "N"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "g7hw-line2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-board"
                                            },
                                            "text": "{{item.board_name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{item.category}}",
                                            "props": {
                                                "className": "g7hw-sep"
                                            },
                                            "text": "·"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{item.category}}",
                                            "props": {
                                                "className": "g7hw-category"
                                            },
                                            "text": "{{item.category}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-views"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "eye",
                                                        "className": "g7hw-eye"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{item.view_count ?? 0}}"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "g7hw-date",
                                                "title": "{{item.created_at ?? ''}}"
                                            },
                                            "text": "{{item.created_at_formatted ?? ''}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "P",
            "if": "{{!col.items || col.items.length === 0}}",
            "props": {
                "className": "g7hw-empty"
            },
            "text": "{{col.empty_text}}"
        }
    ]
}
