# Composer
/vendor/
composer.lock

# Node (only if a build is ever added)
/node_modules/
# dist/ holds the plugin CSS/JS the core bundles (plugin.json assets). They are generated by
# scripts/build-home.sh from resources/css and resources/js and must be tracked (git archive = release zip).
/dist/*
!/dist/css/
!/dist/js/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local / scratch
*.bak
*.bak-*
*.local
*.log

# Site-specific settings — never in the plugin repo
**/setting.json

# Dev-Project notes — kept next to the repo, not in it
/PROJECT.md
